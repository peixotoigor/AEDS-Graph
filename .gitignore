# ==============================================================================
# GUIA RÁPIDO DE SINTAXE DO .GITIGNORE:
#   #              -> Comentário (linhas iniciadas com # são ignoradas pelo Git)
#   pasta/         -> Ignora uma pasta inteira e tudo dentro dela
#   *.extensao     -> Ignora todos os arquivos que terminam com essa extensão
#   !arquivo.ext   -> Regra de exceção: NÃO ignora este arquivo específico
#   /arquivo.ext   -> Ignora o arquivo apenas se estiver exatamente na raiz do projeto
#   arquivo*.txt   -> Ignora qualquer arquivo que comece com 'arquivo' e termine em .txt
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ARQUIVOS DE COMPILAÇÃO E EXECUTÁVEIS (C / C++ / GCC / Clang / MinGW)
# ------------------------------------------------------------------------------
# Arquivos objeto gerados durante a compilação intermediária:
*.o
*.obj

# Bibliotecas estáticas e dinâmicas geradas localmente:
*.a
*.lib
*.so
*.dylib
*.dll

# Executáveis compilados (Windows, Linux, macOS):
*.exe
*.out
*.app

# Pastas de saída comuns de build (crie estas pastas quando compilar seu projeto):
build/
bin/
obj/
dist/
target/
out/
cmake-build-*/

# ------------------------------------------------------------------------------
# 2. EDITORES E IDES (CONFIGURAÇÕES LOCAIS PESSOAIS)
# ------------------------------------------------------------------------------
# VS Code (arquivos de histórico e estados locais; se quiser salvar as configs de debug, adicione !.vscode/launch.json):
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Visual Studio e CLion / JetBrains:
.vs/
.idea/
*.sublime-project
*.sublime-workspace

# Code::Blocks e Dev-C++:
*.depend
*.layout
*.dev.bak

# ------------------------------------------------------------------------------
# 3. SISTEMA OPERACIONAL (WINDOWS / MAC / LINUX)
# ------------------------------------------------------------------------------
# Arquivos de índice e thumbnails do Windows:
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS:
.DS_Store
.AppleDouble
.LSOverride

# ------------------------------------------------------------------------------
# 4. SCRIPTS AUXILIARES / PYTHON (CASO USE NA PASTA /scripts)
# ------------------------------------------------------------------------------
# Arquivos de cache e bytecode do Python:
__pycache__/
*.py[cod]
*$py.class

# Ambientes virtuais (para pacotes Python):
.venv/
env/
venv/
ENV/

# ------------------------------------------------------------------------------
# 5. ARQUIVOS TEMPORÁRIOS, LOGS E BACKUPS
# ------------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 6. LATEX / COMPILAÇÃO DO ARTIGO (report/)
# ------------------------------------------------------------------------------
report/.texbuild/
report/*.aux
report/*.bbl
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.out
report/*.toc
report/*.synctex.gz

# ------------------------------------------------------------------------------
# 7. PRIVACIDADE / LGPD (DADOS PESSOAIS QSA NÃO DEVEM IR PARA REPOSITÓRIOS PÚBLICOS)
# ------------------------------------------------------------------------------
outputs/01_analise_socios/socios_reais.csv
outputs/01_analise_socios/alertas_vinculos_concorrentes.csv
outputs/01_analise_socios/cache_qsa_brasilapi.json
outputs/01_analise_socios/mapeamento_pseudonimos_restrito.csv
database/2025/processed/socios_reais.csv
database/2025/processed/alertas_vinculos_concorrentes.csv
database/2025/processed/01_analise_socios/alertas_vinculos_concorrentes.csv

# PASTAS IGNORADAS

.__pycache__
.pytest_cache
docs/

# Ignora todo o conteúdo dessas pastas...
report/*
outputs/*
scripts/*
database/2025/processed/*

# ... EXCETO a pasta 01_analise_socios:
!outputs/01_analise_socios/
!scripts/01_analise_socios/
!report/01_analise_socios/
!database/2025/processed/01_analise_socios/

# Proteção LGPD (mantém os arquivos sensíveis bloqueados mesmo dentro de 01):
outputs/01_analise_socios/*.csv
outputs/01_analise_socios/*.json
!outputs/01_analise_socios/*.md
!outputs/01_analise_socios/*.txt

skills/

# Ignora arquivos de compilação LaTeX em qualquer pasta
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.toc
*.synctex.gz
.texbuild/